# Copie para .env e preencha. Nunca commite o .env.
# NOME_DO_PROJETO=__NOME_DO_PROJETO__

# Supabase (projeto do cliente; chaves anônimas só no .env, nunca no git)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só no servidor. Nunca NEXT_PUBLIC_. Sem ela, ações críticas usam memória
# (falha segura: aprovação responde 404 e não executa).
# SUPABASE_SERVICE_ROLE_KEY=

# Harness de agente (VTX-177). Chave de provedor só no servidor, nunca NEXT_PUBLIC_.
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_MS=30000
# AGENT_MODEL_API_KEY=
# Modelo falso para testes e e2e (VTX-211). Sem provedor real neste template.
# AGENT_MODELO_FALSO=1
